+fn reference(
+    size: u32,
+    alpha: &[u8],
+    options: &AlphaMeshOptions,
+) -> (MultiPolygon<f64>, MultiPolygon<f64>, MultiPolygon<f64>) {
+    let mut rectangles = Vec::new();
+    for y in 0..size {
+        let mut x = 0;
+        while x < size {
+            if alpha[(y * size + x) as usize] <= options.alpha_threshold {
+                x += 1;
+                continue;
+            }
+            let start = x;
+            while x < size && alpha[(y * size + x) as usize] > options.alpha_threshold {
+                x += 1;
+            }
+            rectangles.push(
+                Rect::new(
+                    (start as f64, (size - y - 1) as f64),
+                    (x as f64, (size - y) as f64),
+                )
+                .to_polygon(),
+            );
+        }
+    }
+    let source = unary_union(&rectangles);
+    let envelope = if options.preserve_holes {
+        source.clone()
+    } else {
+        unary_union(
+            &source
+                .0
+                .iter()
+                .map(|p| Polygon::new(p.exterior().clone(), vec![]))
+                .collect::<Vec<_>>(),
+        )
+    };
+    let image = MultiPolygon(vec![
+        Rect::new((0., 0.), (size as f64, size as f64)).to_polygon()
+    ]);
+    let offset = |distance| {
+        let shape = if distance == 0.0 {
+            envelope.clone()
+        } else {
+            envelope.buffer(distance)
+        };
+        if options.clip_to_image {
+            shape.intersection(&image)
+        } else {
+            shape
+        }
+    };
+    let minimum = offset(options.minimum_margin);
+    let maximum = offset(options.outside_margin);
+    (source, minimum, maximum)
