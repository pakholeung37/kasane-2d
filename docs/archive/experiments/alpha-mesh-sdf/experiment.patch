diff --git a/modules/kasane-sdk/src/alpha_mesh/offset.rs b/modules/kasane-sdk/src/alpha_mesh/offset.rs
new file mode 100644
--- /dev/null
+++ b/modules/kasane-sdk/src/alpha_mesh/offset.rs
@@ -0,0 +1,31 @@
+//! Keep the vector implementation as the default and oracle for SDF experiments.
+use crate::SdkError;
+use geo::{Buffer, MultiPolygon, Polygon};
+
+pub(super) enum Offsets {
+    Vector,
+    #[cfg(feature = "experimental-alpha-sdf")]
+    Sdf(super::sdf::Offsets),
+}
+
+impl Offsets {
+    pub fn buffer(
+        &mut self,
+        source: &MultiPolygon<f64>,
+        distance: f64,
+    ) -> Result<MultiPolygon<f64>, SdkError> {
+        match self {
+            Self::Vector => Ok(source.buffer(distance)),
+            #[cfg(feature = "experimental-alpha-sdf")]
+            Self::Sdf(sdf) => sdf.buffer(source, distance),
+        }
+    }
+
+    pub fn polygon(
+        &mut self,
+        source: &Polygon<f64>,
+        distance: f64,
+    ) -> Result<MultiPolygon<f64>, SdkError> {
+        self.buffer(&MultiPolygon(vec![source.clone()]), distance)
+    }
+}
diff --git a/modules/kasane-sdk/src/alpha_mesh/sdf.rs b/modules/kasane-sdk/src/alpha_mesh/sdf.rs
new file mode 100644
--- /dev/null
+++ b/modules/kasane-sdk/src/alpha_mesh/sdf.rs
@@ -0,0 +1,459 @@
+//! Experimental raster offsets. Pixel-square boundaries seed an exact grid EDT;
+//! rasterization of non-raster polygons and contour interpolation remain approximate.
+use super::{error, limit};
+use crate::SdkError;
+use geo::{
+    Area, BoundingRect, Buffer, Contains, Coord, LineString, MultiPolygon, Point, Polygon, Simplify,
+};
+use std::collections::HashMap;
+
+const MAX_SAMPLES: usize = 16 * 1024 * 1024;
+
+pub(super) struct Offsets {
+    step: f64,
+    vector_ring_limit: usize,
+    cache: Vec<(MultiPolygon<f64>, Field)>,
+}
+
+impl Offsets {
+    pub fn new(step: f64, vector_ring_limit: usize) -> Result<Self, SdkError> {
+        if !step.is_finite() || !(0.25..=2.0).contains(&step) {
+            return Err(error(
+                "INVALID_ALPHA_SDF_STEP",
+                "Use an experimental SDF grid step in 0.25..=2 pixels",
+            ));
+        }
+        Ok(Self {
+            step,
+            vector_ring_limit,
+            cache: Vec::new(),
+        })
+    }
+
+    pub fn buffer(
+        &mut self,
+        source: &MultiPolygon<f64>,
+        distance: f64,
+    ) -> Result<MultiPolygon<f64>, SdkError> {
+        if distance == 0.0 || source.0.is_empty() {
+            return Ok(source.clone());
+        }
+        if self.vector_ring_limit > 0
+            && source
+                .0
+                .iter()
+                .flat_map(|p| std::iter::once(p.exterior()).chain(p.interiors()))
+                .all(|r| r.0.len().saturating_sub(1) <= self.vector_ring_limit)
+        {
+            return Ok(source.buffer(distance));
+        }
+        if let Some((_, field)) = self
+            .cache
+            .iter()
+            .find(|(shape, field)| shape == source && field.padding >= distance.max(0.0))
+        {
+            return field.contours(distance);
+        }
+        // Two recent fields reuse exterior/minimum and inset/guard queries.
+        // Bound retained storage independently of the number of small islands.
+        let field = Field::new(source, self.step, distance.max(0.0))?;
+        let result = field.contours(distance)?;
+        while self.cache.len() >= 2
+            || self
+                .cache
+                .iter()
+                .map(|(_, f)| f.values.len())
+                .sum::<usize>()
+                + field.values.len()
+                > MAX_SAMPLES
+        {
+            self.cache.remove(0);
+        }
+        self.cache.push((source.clone(), field));
+        Ok(result)
+    }
+}
+
+struct Field {
+    origin: [f64; 2],
+    step: f64,
+    nx: usize,
+    ny: usize,
+    padding: f64,
+    values: Vec<f32>,
+}
+
+impl Field {
+    fn new(source: &MultiPolygon<f64>, step: f64, padding: f64) -> Result<Self, SdkError> {
+        let bounds = source.bounding_rect().ok_or_else(limit)?;
+        let pad = (padding / step).ceil() + 2.0;
+        let origin = [
+            (bounds.min().x / step).floor() - pad,
+            (bounds.min().y / step).floor() - pad,
+        ];
+        let columns = (bounds.max().x / step).ceil() - origin[0] + pad;
+        let rows = (bounds.max().y / step).ceil() - origin[1] + pad;
+        if !columns.is_finite()
+            || !rows.is_finite()
+            || (columns + 1.0) * (rows + 1.0) > MAX_SAMPLES as f64
+        {
+            return Err(limit());
+        }
+        let (w, h) = (columns as usize, rows as usize);
+        let origin = [origin[0] * step, origin[1] * step];
+        let mut filled = vec![false; w * h];
+        let edges: Vec<_> = source
+            .0
+            .iter()
+            .flat_map(|p| std::iter::once(p.exterior()).chain(p.interiors()))
+            .flat_map(|r| r.0.windows(2).map(|s| (s[0], s[1])))
+            .filter(|(a, b)| a.y != b.y)
+            .collect();
+        if edges.len().saturating_mul(h) > 64 * 1024 * 1024 {
+            return Err(limit());
+        }
+        let mut crossings = Vec::new();
+        for y in 0..h {
+            let py = origin[1] + (y as f64 + 0.5) * step;
+            crossings.clear();
+            for &(a, b) in &edges {
+                if (a.y > py) != (b.y > py) {
+                    crossings.push(a.x + (py - a.y) * (b.x - a.x) / (b.y - a.y));
+                }
+            }
+            crossings.sort_by(f64::total_cmp);
+            for pair in crossings.chunks_exact(2) {
+                let left = ((pair[0] - origin[0]) / step - 0.5)
+                    .ceil()
+                    .clamp(0.0, w as f64) as usize;
+                let right = ((pair[1] - origin[0]) / step - 0.5)
+                    .ceil()
+                    .clamp(0.0, w as f64) as usize;
+                filled[y * w + left..y * w + right].fill(true);
+            }
+        }
+        let (nx, ny) = (w + 1, h + 1);
+        let mut values = vec![f32::INFINITY; nx * ny];
+        let pixel = |x: usize, y: usize| x < w && y < h && filled[y * w + x];
+        // At grid nodes the closest point on an axis-aligned raster edge is
+        // another grid node. Seeding all boundary nodes gives exact distances
+        // there, including pixel corners (unlike a center EDT minus 0.5).
+        for y in 0..ny {
+            for x in 0..nx {
+                let adjacent = [
+                    pixel(x, y),
+                    pixel(x.wrapping_sub(1), y),
+                    pixel(x, y.wrapping_sub(1)),
+                    pixel(x.wrapping_sub(1), y.wrapping_sub(1)),
+                ];
+                if adjacent.iter().any(|&v| v) && adjacent.iter().any(|&v| !v) {
+                    values[y * nx + x] = 0.0;
+                }
+            }
+        }
+        let mut transform = Transform::new(nx.max(ny));
+        for row in values.chunks_exact_mut(nx) {
+            transform.apply(row);
+        }
+        let mut column = vec![0.0; ny];
+        for x in 0..nx {
+            for y in 0..ny {
+                column[y] = values[y * nx + x];
+            }
+            transform.apply(&mut column);
+            for y in 0..ny {
+                let sign = if pixel(x, y) { -1.0 } else { 1.0 };
+                values[y * nx + x] = column[y].sqrt() * step as f32 * sign;
+            }
+        }
+        Ok(Self {
+            origin,
+            step,
+            nx,
+            ny,
+            padding,
+            values,
+        })
+    }
+
+    fn contours(&self, level: f64) -> Result<MultiPolygon<f64>, SdkError> {
+        // Resolve exact-on-node levels consistently. Remove resulting tiny
+        // segments before f32 export; this is part of the experimental error.
+        let level = level + self.step * 1e-7;
+        let mut nodes: HashMap<usize, (Coord<f64>, Vec<usize>)> = HashMap::new();
+        let mut order = Vec::new();
+        for y in 0..self.ny - 1 {
+            for x in 0..self.nx - 1 {
+                let indices = [
+                    y * self.nx + x,
+                    y * self.nx + x + 1,
+                    (y + 1) * self.nx + x + 1,
+                    (y + 1) * self.nx + x,
+                ];
+                let f = indices.map(|i| level - self.values[i] as f64);
+                let inside = f.map(|v| v >= 0.0);
+                if inside.iter().all(|&v| v) || inside.iter().all(|&v| !v) {
+                    continue;
+                }
+                let points = [(x, y), (x + 1, y), (x + 1, y + 1), (x, y + 1)];
+                let keys = [
+                    y * (self.nx - 1) + x,
+                    (self.nx - 1) * self.ny + y * self.nx + x + 1,
+                    (y + 1) * (self.nx - 1) + x,
+                    (self.nx - 1) * self.ny + y * self.nx + x,
+                ];
+                let mut crossings = Vec::with_capacity(4);
+                for i in 0..4 {
+                    let j = (i + 1) % 4;
+                    if inside[i] == inside[j] {
+                        continue;
+                    }
+                    let t = f[i] / (f[i] - f[j]);
+                    let p = Coord {
+                        x: self.origin[0]
+                            + (points[i].0 as f64 + t * (points[j].0 as f64 - points[i].0 as f64))
+                                * self.step,
+                        y: self.origin[1]
+                            + (points[i].1 as f64 + t * (points[j].1 as f64 - points[i].1 as f64))
+                                * self.step,
+                    };
+                    crossings.push(i);
+                    nodes.entry(keys[i]).or_insert_with(|| {
+                        order.push(keys[i]);
+                        (p, Vec::with_capacity(2))
+                    });
+                }
+                let pairs = if crossings.len() == 2 {
+                    vec![(crossings[0], crossings[1])]
+                } else if f[0] * f[2] >= f[1] * f[3] {
+                    vec![(0, 1), (2, 3)]
+                } else {
+                    vec![(0, 3), (1, 2)]
+                };
+                for (a, b) in pairs {
+                    nodes.get_mut(&keys[a]).unwrap().1.push(keys[b]);
+                    nodes.get_mut(&keys[b]).unwrap().1.push(keys[a]);
+                }
+                if nodes.len() > 1_048_576 {
+                    return Err(limit());
+                }
+            }
+        }
+        let mut rings = Vec::new();
+        for start in order {
+            if !nodes.contains_key(&start) {
+                continue;
+            }
+            let mut ring = Vec::new();
+            let (mut previous, mut current) = (usize::MAX, start);
+            loop {
+                let (p, neighbors) = nodes.remove(&current).ok_or_else(|| {
+                    error("ALPHA_SDF_CONTOUR", "Open or intersecting SDF contour")
+                })?;
+                if neighbors.len() != 2 {
+                    return Err(error(
+                        "ALPHA_SDF_CONTOUR",
+                        "SDF contour reaches the field boundary",
+                    ));
+                }
+                ring.push(p);
+                let next = if neighbors[0] == previous {
+                    neighbors[1]
+                } else {
+                    neighbors[0]
+                };
+                previous = current;
+                current = next;
+                if current == start {
+                    break;
+                }
+            }
+            ring.push(ring[0]);
+            let ring = LineString(ring).simplify(self.step * 0.001);
+            if ring.0.len() >= 4 {
+                rings.push(Polygon::new(ring, vec![]));
+            }
+        }
+        rings.sort_by(|a, b| b.unsigned_area().total_cmp(&a.unsigned_area()));
+        let mut depths = vec![0; rings.len()];
+        let mut owners = vec![0; rings.len()];
+        let mut output: Vec<Polygon<f64>> = Vec::new();
+        let mut checks = 0;
+        for i in 0..rings.len() {
+            let p = Point::from(rings[i].exterior().0[0]);
+            let mut parent = None;
+            for j in (0..i).rev() {
+                checks += 1;
+                if checks > 1_048_576 {
+                    return Err(limit());
+                }
+                if rings[j].contains(&p) {
+                    parent = Some(j);
+                    break;
+                }
+            }
+            depths[i] = parent.map_or(0, |j| depths[j] + 1);
+            if depths[i] % 2 == 0 {
+                owners[i] = output.len();
+                output.push(rings[i].clone());
+            } else {
+                owners[i] = owners[parent.unwrap()];
+                output[owners[i]].interiors_push(rings[i].exterior().clone());
+            }
+        }
+        Ok(MultiPolygon(output))
+    }
+}
+
+/// Separable squared EDT, lower envelope of parabolas (Felzenszwalb/Huttenlocher).
+/// https://theoryofcomputing.org/articles/v008a019/
+struct Transform {
+    sites: Vec<usize>,
+    limits: Vec<f64>,
+    input: Vec<f32>,
+}
+impl Transform {
+    fn new(n: usize) -> Self {
+        Self {
+            sites: Vec::with_capacity(n),
+            limits: Vec::with_capacity(n),
+            input: Vec::with_capacity(n),
+        }
+    }
+    fn apply(&mut self, values: &mut [f32]) {
+        self.input.clear();
+        self.input.extend_from_slice(values);
+        self.sites.clear();
+        self.limits.clear();
+        for (q, &cost) in self.input.iter().enumerate() {
+            if !cost.is_finite() {
+                continue;
+            }
+            let mut crossing = f64::NEG_INFINITY;
+            while let Some(&p) = self.sites.last() {
+                crossing = ((cost as f64 + (q * q) as f64)
+                    - (self.input[p] as f64 + (p * p) as f64))
+                    / (2.0 * (q - p) as f64);
+                if crossing > *self.limits.last().unwrap() {
+                    break;
+                }
+                self.sites.pop();
+                self.limits.pop();
+            }
+            if self.sites.is_empty() {
+                crossing = f64::NEG_INFINITY;
+            }
+            self.sites.push(q);
+            self.limits.push(crossing);
+        }
+        if self.sites.is_empty() {
+            return;
+        }
+        let mut k = 0;
+        for (q, value) in values.iter_mut().enumerate() {
+            while k + 1 < self.sites.len() && self.limits[k + 1] < q as f64 {
+                k += 1;
+            }
+            let p = self.sites[k];
+            *value = ((q as f64 - p as f64).powi(2) + self.input[p] as f64) as f32;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use geo::Rect;
+
+    #[test]
+    fn transform_matches_brute_force_including_empty_scanlines() {
+        let mut transform = Transform::new(32);
+        for seed in 0..32 {
+            let input: Vec<_> = (0..32)
+                .map(|x| {
+                    if (x * 17 + seed * 7) % 11 < 3 {
+                        (x % 5) as f32
+                    } else {
+                        f32::INFINITY
+                    }
+                })
+                .collect();
+            let mut actual = input.clone();
+            transform.apply(&mut actual);
+            for (x, &distance) in actual.iter().enumerate() {
+                let expected = input
+                    .iter()
+                    .enumerate()
+                    .map(|(y, &v)| v + (x as f32 - y as f32).powi(2))
+                    .fold(f32::INFINITY, f32::min);
+                assert_eq!(distance, expected);
+            }
+        }
+        let mut empty = [f32::INFINITY; 32];
+        transform.apply(&mut empty);
+        assert!(empty.iter().all(|v| v.is_infinite()));
+    }
+
+    #[test]
+    fn grid_distances_match_pixel_square_edges_and_corners() {
+        let source = MultiPolygon(vec![Rect::new((0., 0.), (4., 6.)).to_polygon()]);
+        for step in [0.25, 0.5, 1., 2.] {
+            let field = Field::new(&source, step, 3.).unwrap();
+            for y in 0..field.ny {
+                for x in 0..field.nx {
+                    let px = field.origin[0] + x as f64 * step;
+                    let py = field.origin[1] + y as f64 * step;
+                    let dx = (-px).max(px - 4.).max(0.);
+                    let dy = (-py).max(py - 6.).max(0.);
+                    let expected = if dx > 0. || dy > 0. {
+                        dx.hypot(dy)
+                    } else {
+                        -px.min(4. - px).min(py).min(6. - py)
+                    };
+                    assert!((field.values[y * field.nx + x] as f64 - expected).abs() < 1e-5);
+                }
+            }
+            let inset = field.contours(-1.).unwrap();
+            assert!(inset.contains(&Point::new(2., 3.)));
+            assert!(!inset.contains(&Point::new(0.5, 3.)));
+            assert!(field.contours(-4.).unwrap().0.is_empty());
+        }
+    }
+
+    #[test]
+    fn zero_offsets_preserve_exact_geometry_and_large_fields_are_bounded() {
+        let source = MultiPolygon(vec![Rect::new((0., 0.), (1., 1.)).to_polygon()]);
+        let mut offsets = Offsets::new(0.5, 0).unwrap();
+        assert_eq!(offsets.buffer(&source, 0.).unwrap(), source);
+        assert!(offsets.buffer(&source, 1_000_000.).is_err());
+        for invalid in [0., f64::NAN, f64::INFINITY, 0.01] {
+            assert!(Offsets::new(invalid, 0).is_err());
+        }
+    }
+
+    #[test]
+    fn marching_squares_keeps_holes_nested_islands_and_deterministic_saddles() {
+        let rect = |a, b| Rect::new(a, b).to_polygon();
+        let source = MultiPolygon(vec![
+            Polygon::new(
+                rect((0., 0.), (20., 20.)).exterior().clone(),
+                vec![rect((4., 4.), (16., 16.)).exterior().clone()],
+            ),
+            rect((8., 8.), (12., 12.)),
+        ]);
+        let mut offsets = Offsets::new(0.5, 0).unwrap();
+        let expanded = offsets.buffer(&source, 1.).unwrap();
+        assert!(super::super::spatial::is_valid(&expanded).unwrap());
+        assert!(expanded.contains(&Point::new(1., 1.)));
+        assert!(!expanded.contains(&Point::new(6., 6.)));
+        assert!(expanded.contains(&Point::new(10., 10.)));
+        assert_eq!(expanded, offsets.buffer(&source, 1.).unwrap());
+        let saddle = MultiPolygon(vec![rect((0., 0.), (1., 1.)), rect((1., 1.), (2., 2.))]);
+        let a = offsets.buffer(&saddle, 0.5).unwrap();
+        assert!(super::super::spatial::is_valid(&a).unwrap());
+        assert_eq!(
+            a,
+            Offsets::new(0.5, 0).unwrap().buffer(&saddle, 0.5).unwrap()
+        );
+    }
+}
