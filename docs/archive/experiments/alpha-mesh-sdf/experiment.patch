diff --git a/tools/alpha_mesh_sdf_bench.py b/tools/alpha_mesh_sdf_bench.py
new file mode 100644
--- /dev/null
+++ b/tools/alpha_mesh_sdf_bench.py
@@ -0,0 +1,81 @@
+"""Compare vector, pure SDF and hybrid offsets without changing the default backend.
+
+uv run --locked python tools/alpha_mesh_sdf_bench.py --contracts
+uv run --locked --with matplotlib python tools/alpha_mesh_sdf_plot.py
+
+Contract failures are recorded as experimental results, not silently retried
+with the vector backend. Timing excludes mask construction and quality checks.
+"""
+import argparse
+import csv
+import json
+import os
+from pathlib import Path
+import platform
+import re
+import subprocess
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--runs", type=int, default=9)
+    parser.add_argument("--contracts", action="store_true")
+    parser.add_argument("--output", type=Path, default=Path("target/alpha-sdf"))
+    args = parser.parse_args()
+    if args.runs < 1:
+        parser.error("--runs must be positive")
+    root = Path(__file__).resolve().parents[1]
+    output = (root / args.output).resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    build = ["cargo", "build", "--release", "--locked", "-p", "kasane-sdk",
+             "--features", "experimental-alpha-sdf", "--example", "alpha_mesh_profile"]
+    # Cargo's JSON output locates the binary even with CARGO_TARGET_DIR overrides.
+    built = subprocess.run(build + ["--message-format=json"], cwd=root, text=True, stdout=subprocess.PIPE, check=True)
+    binary = next(item["executable"] for line in built.stdout.splitlines()
+                  if (item := json.loads(line)).get("reason") == "compiler-artifact"
+                  and item.get("target", {}).get("name") == "alpha_mesh_profile" and item.get("executable"))
+    configurations = [("vector", "vector", "pure"), ("sdf-1", "1", "pure"),
+                      ("sdf-0.5", "0.5", "pure"), ("hybrid-1", "1", "hybrid"), ("interior-1", "1", "interior")]
+    for name, step, mode in configurations:
+        print(f"Benchmark: {name}, {args.runs} runs", flush=True)
+        with (output / f"{name}.csv").open("w") as stream:
+            subprocess.run([binary, str(args.runs), step, mode, str(output / "meshes")],
+                           cwd=root, stdout=stream, check=True)
+    with (output / "comparison.csv").open("w") as stream:
+        writer = None
+        for name, _, _ in configurations:
+            with (output / f"{name}.csv").open() as source:
+                reader = csv.DictReader(source)
+                if writer is None:
+                    writer = csv.DictWriter(stream, fieldnames=reader.fieldnames)
+                    writer.writeheader()
+                writer.writerows(reader)
+    metadata = {"runs": args.runs, "platform": platform.platform(), "machine": platform.machine(),
+                "rustc": subprocess.check_output(["rustc", "--version"], text=True).strip(),
+                "contracts": {}}
+    if args.contracts:
+        command = ["cargo", "test", "--release", "--locked", "-p", "kasane-sdk",
+                   "--features", "experimental-alpha-sdf", "--test", "alpha_mesh"]
+        for name, step, mode in configurations:
+            env = os.environ.copy()
+            env.pop("KASANE_ALPHA_TEST_SDF_STEP", None)
+            env.pop("KASANE_ALPHA_TEST_SDF_HYBRID", None)
+            env.pop("KASANE_ALPHA_TEST_SDF_INTERIOR", None)
+            if step != "vector":
+                env["KASANE_ALPHA_TEST_SDF_STEP"] = step
+                env["KASANE_ALPHA_TEST_SDF_HYBRID"] = "1" if mode != "pure" else "0"
+                env["KASANE_ALPHA_TEST_SDF_INTERIOR"] = "1" if mode == "interior" else "0"
+            result = subprocess.run(command, cwd=root, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+            (output / f"contracts-{name}.log").write_text(result.stdout)
+            summary = re.search(r"test result: \w+\. (\d+) passed; (\d+) failed", result.stdout)
+            if summary is None:
+                raise RuntimeError(f"Contract runner failed before producing results: {output / f'contracts-{name}.log'}")
+            passed, failed = map(int, summary.groups())
+            metadata["contracts"][name] = {"passed": passed, "failed": failed, "exit_code": result.returncode}
+            print(f"Contracts: {name}: {passed} passed, {failed} failed", flush=True)
+    (output / "run.json").write_text(json.dumps(metadata, indent=2) + "\n")
+    print(f"Results: {output}")
+
+
+if __name__ == "__main__":
+    main()
