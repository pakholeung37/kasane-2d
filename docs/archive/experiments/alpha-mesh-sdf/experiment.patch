+                        (p[2].x as f64, p[2].y as f64),
+                        (p[0].x as f64, p[0].y as f64),
+                    ]
+                    .into(),
+                    vec![],
+                )
+            })
+            .collect::<Vec<_>>(),
+    )
+}

