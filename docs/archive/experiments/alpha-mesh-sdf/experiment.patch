+++ b/tools/alpha_mesh_sdf_plot.py
@@ -0,0 +1,85 @@
+"""Render exported benchmark meshes: uv run --locked --with matplotlib python tools/alpha_mesh_sdf_plot.py.
+
+Input/output directory defaults to target/alpha-sdf. Generate meshes with the
+alpha_mesh_profile Rust example's OUTPUT_DIRECTORY argument first.
+"""
+import argparse
+import csv
+import json
+from pathlib import Path
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+from matplotlib.collections import LineCollection
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("directory", nargs="?", type=Path, default=Path("target/alpha-sdf"))
+    args = parser.parse_args()
+    cases = [
+        ("circle", "Circle", (0, 512, 0, 512)),
+        ("thin", "Curved thin strip", (0, 512, 120, 392)),
+        ("equal_margin", "Equal margin / boundary detail", (467, 493, 235, 277)),
+        ("diagonal_half_margin", "0.5 px margin / contact detail", (8, 16, 8, 16)),
+    ]
+    backends = [("vector", "Vector baseline"), ("sdf-1", "SDF / 1 px"), ("sdf-0.5", "SDF / 0.5 px"), ("interior-1", "Vector outline / SDF interior")]
+    fig, axes = plt.subplots(len(cases), len(backends), figsize=(16, 14), layout="constrained")
+    fig.set_facecolor("#f5f7fa")
+    fig.suptitle("Alpha mesh: vector vs raster distance fields", fontsize=19, weight="bold")
+    for row, (case, label, limits) in enumerate(cases):
+        for col, (backend, title) in enumerate(backends):
+            ax = axes[row, col]
+            data = json.loads((args.directory / "meshes" / f"{case}-{backend}.json").read_text())
+            for polygon in data["source"]:
+                for i, ring in enumerate(polygon):
+                    ax.fill(*zip(*ring), color="#ccd6df" if i == 0 else "white", zorder=0)
+            positions = data["positions"]
+            edges = set()
+            for triangle in data["triangles"]:
+                for i in range(3):
+                    a, b = triangle[i], triangle[(i + 1) % 3]
+                    edges.add((min(a, b), max(a, b)))
+            segments = [(positions[a], positions[b]) for a, b in sorted(edges)]
+            ax.add_collection(LineCollection(segments, colors="#245a83", linewidths=0.65))
+            if row >= 2:
+                ax.scatter(*zip(*positions), s=4, color="#de7143", zorder=3)
+            ax.set(xlim=limits[:2], ylim=limits[2:], aspect="equal")
+            ax.set_title((title + "\n" if row == 0 else "") + label, fontsize=10)
+            ax.text(0.02, 0.02, f"{len(positions):,} vertices / {len(data['triangles']):,} triangles (whole mesh)",
+                    transform=ax.transAxes, fontsize=8, bbox={"facecolor": "white", "alpha": 0.9, "edgecolor": "none"})
+            ax.tick_params(labelsize=7)
+            for spine in ax.spines.values():
+                spine.set_color("#cbd4dd")
+    fig.savefig(args.directory / "mesh-comparison.png", dpi=160)
+    plt.close(fig)
+
+    rows = []
+    for name in ["vector", "sdf-1", "sdf-0.5", "hybrid-1", "interior-1"]:
+        path = args.directory / f"{name}.csv"
+        if path.exists():
+            with path.open() as stream:
+                rows.extend(csv.DictReader(stream))
+    if not rows:
+        return
+    cases = ["rectangle", "circle", "curved_sharp", "islands", "holes", "thin", "equal_margin", "large_circle"]
+    fig, ax = plt.subplots(figsize=(12, 5), layout="constrained")
+    colors = ["#566477", "#468ac0", "#df9c59", "#459878", "#8666aa"]
+    for i, backend in enumerate(["vector", "sdf-1", "sdf-0.5", "hybrid-1", "interior-1"]):
+        timings = {row["case"]: float(row["median_ms"]) for row in rows if row["backend"] == backend and row["status"] == "ok"}
+        ax.bar([x + (i - 2) * 0.16 for x in range(len(cases))], [timings.get(case, 0) for case in cases],
+               width=0.16, label=backend, color=colors[i])
+    ax.set_xticks(range(len(cases)), [case.replace("_", " ") for case in cases], rotation=15)
+    ax.set_ylabel("Generation time / ms (median of 9 release runs)")
+    ax.set_title("Generation time; mask construction and quality checks excluded")
+    ax.legend(frameon=False)
+    ax.grid(axis="y", alpha=0.15)
+    ax.set_axisbelow(True)
+    fig.savefig(args.directory / "timing-comparison.png", dpi=160)
+    plt.close(fig)
+
+
+if __name__ == "__main__":
+    main()
