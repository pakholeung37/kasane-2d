[configuration]
entry_symbol="kasane_gd_library_init"
compatibility_minimum="4.3"

[libraries]
macos.debug.arm64="res://../target/debug/libkasane_godot.dylib"
macos.release.arm64="res://../target/release/libkasane_godot.dylib"
linux.debug.x86_64="res://../target/debug/libkasane_godot.so"
linux.release.x86_64="res://../target/release/libkasane_godot.so"
windows.debug.x86_64="res://../target/debug/kasane_godot.dll"
windows.release.x86_64="res://../target/release/kasane_godot.dll"
